GET  /products              => db.products.order("name")
GET  /products/:id          => db.products.find(id)
GET  /products/search       => db.products.search("name", query.q)
GET  /products/by/:tag      => db.products.where("tag", tag)
GET  /products/stocked      => db.products.where("stock", ">", 0).order("name").select("id", "name", "price", "stock")
POST /products              => db.products.create({ id: body.id, name: body.name, tag: body.tag, price: body.price, stock: default(body.stock, 0) }, "name") when check(body.id, "id is required") and check(body.name, "name is required")
PUT  /products/:id          => db.products.update(id, body, "name")
POST /products/:id/restock  => db.products.incr(id, "stock", default(body.by, 1))
