POST /signup => db.users.create({ id: lower(trim(body.email)), email: lower(trim(body.email)), pass: password(body.pass) }).email when limit("signup:" + default(header.x_real_ip, "all"), 5) and body.email and body.pass else 400 "email and pass are required"

POST /login  => db.sessions.create({ id: setcookie("session", uuid()), user: lower(trim(body.email)), at: now(), until: now() + 86400000 }).user when limit("login:" + lower(trim(body.email)), 5) and verify(body.pass, db.users.find(lower(trim(body.email))).pass) else 401 "wrong email or password"

GET  /me     => db.users.find(db.sessions.find(default(cookie.session, header.x_token)).user).select("id", "email") when db.sessions.where("id", default(cookie.session, header.x_token)).count() and db.sessions.find(default(cookie.session, header.x_token)).until > now()

DELETE /logout => [db.sessions.delete(default(cookie.session, header.x_token)), setcookie("session", "")] : 204 when db.sessions.where("id", default(cookie.session, header.x_token)).count()

GET  /admin  => db.users.select("id", "email") when header.authorization == env("ADMIN_TOKEN") else 403

DELETE /sessions/stale => db.sessions.delete_where("until", "<", now()) when header.authorization == env("ADMIN_TOKEN") else 403
