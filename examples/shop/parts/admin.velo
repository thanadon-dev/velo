GET /admin/revenue          => { orders: db.orders.count(), sold: db.orders.sum("qty"), avg: db.orders.avg("qty"), largest: db.orders.max("qty") } when header.authorization == env("ADMIN_TOKEN") else 403 "admin token required"
GET /admin/products         => db.products.order("name") when header.authorization == env("ADMIN_TOKEN") else 403 "admin token required"
GET /admin/low              => db.products.where("stock", "<", 5).order("stock").select("id", "name", "stock") when header.authorization == env("ADMIN_TOKEN") else 403 "admin token required"
GET /admin/orders/by/tier   => db.orders.group("tier").count() when header.authorization == env("ADMIN_TOKEN") else 403 "admin token required"
