GET  /health              => "ok"
GET  /openapi.json        => openapi()
GET  /version             => { name: "velo", version: "1.5.0" }

GET  /users               => db.users.all()
GET  /users/:id           => db.users.find(id)
POST /users               => db.users.create(body) when body.name else 400
PUT  /users/:id           => db.users.upsert(id, body)
DELETE /users/:id         => db.users.delete(id) : 204
GET  /users/page          => db.users.page(default(query.offset, 0), default(query.limit, 20)) when default(query.limit, 20) <= 200 else 400
GET  /users/sorted        => db.users.order(query.by)
GET  /users/mine          => db.users.where("team", header.x_team)
GET  /admin/users         => db.users.all() when header.authorization == env("ADMIN_TOKEN")
GET  /users/by/team       => db.users.where("team", query.team)
GET  /users/top           => db.users.where("team", query.team).order("-score").page(0, 20)
GET  /users/top/count     => db.users.where("team", query.team).count()
GET  /users/top/one       => db.users.where("team", query.team).order("-score").first()
GET  /users/strong        => db.users.where("score", ">=", query.min).order("-score").page(0, 20)

GET  /posts               => db.posts.all()
POST /posts               => db.posts.create(body)
GET  /posts/:id           => db.posts.find(id)
GET  /posts/of/:author    => db.posts.where("author", author)

GET  /stats               => { users: db.users.count(), posts: db.posts.count() }
GET  /scores              => { total: db.users.sum("score"), avg: db.users.avg("score"), best: db.users.max("score") }
GET  /teams/:tid/members/:mid => { team: tid, member: mid }
GET  /search              => { q: query.q, page: query.page }
POST /events              => db.events.create({ id: uuid(), at: now(), data: body })
GET  /events              => db.events.all()
