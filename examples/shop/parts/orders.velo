GET  /orders                => db.orders.page(query.offset, query.limit)
GET  /orders/:id            => db.orders.find(id)
POST /orders                => db.orders.create({ id: uuid(), at: now(), item: body.item, amount: body.amount, customer: header.x_customer }) when body.item or 400
DELETE /orders/:id          => db.orders.delete(id) : 204
GET  /orders/mine           => db.orders.where("customer", header.x_customer) when header.x_customer or 400
