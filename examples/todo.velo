GET    /health              => "ok"

GET    /todos               => db.todos.order("-id")
GET    /todos/:id           => db.todos.find(id)
POST   /todos               => db.todos.create({ id: uuid(), at: date(now()), text: body.text, done: false }) when body.text else 400
PUT    /todos/:id           => db.todos.update(id, body)
DELETE /todos/:id           => db.todos.delete(id) : 204

GET    /todos/open          => db.todos.where("done", false)
GET    /todos/by/:text      => db.todos.first("text", text)
GET    /todos/search        => db.todos.search("text", query.q)
GET    /todos/count         => { open: len(db.todos.where("done", false)), all: db.todos.count() }
